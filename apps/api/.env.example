# Core
DATABASE_URL=postgresql://rivertown:rivertown@localhost:5432/rivertown
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-32+-char-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins (production only)
CORS_ORIGINS=

# Public-facing API URL (used in invoice view links sent via email)
API_BASE_URL=https://rivertownapi-production.up.railway.app

# Google OAuth (SSO + email)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_EMAIL_REDIRECT_URI=
FRONTEND_URL=https://psa.rivertowntechnology.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_PATH=stripe

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=

# Twilio (optional fallback — prefer per-tenant config in Settings > Integrations)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Passkeys (WebAuthn)
PASSKEY_RP_ID=portal.rivertowntechnology.com
PASSKEY_ORIGIN=https://portal.rivertowntechnology.com

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_SANDBOX=false

# Apple Push Notification service (iOS push, token-based .p8 auth)
#
# Preferred: configure in-app under Settings > Integrations > Apple Push —
# credentials are stored encrypted in the database (same mechanism as
# Twilio/QuickBooks) and can be updated without a redeploy.
#
# These env vars are only a fallback, used if no Apple Push config exists in
# the database yet (e.g. for local dev bootstrap):
# Key ID of the .p8 signing key, from Apple Developer > Certificates, IDs & Profiles > Keys
APNS_KEY_ID=
# Your Apple Developer Team ID
APNS_TEAM_ID=
# iOS app's bundle identifier — sent as the apns-topic header
APNS_BUNDLE_ID=
# Contents of the .p8 key (PEM, with \n escaped) OR an absolute path to the .p8 file
APNS_KEY_P8=
