# Core
DATABASE_URL=postgresql://rivertown:rivertown@localhost:5432/rivertown
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-32+-char-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins (production only)
CORS_ORIGINS=

# Public-facing API URL (used in invoice view links sent via email)
API_BASE_URL=https://rivertownapi-production.up.railway.app

# Google OAuth (SSO + email)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_EMAIL_REDIRECT_URI=
FRONTEND_URL=https://psa.rivertowntechnology.com

# Microsoft Entra ID SSO (staff "Sign in with Microsoft") — single Entra tenant.
# MS_TENANT_ID is the Directory (tenant) ID / GUID. MS_REDIRECT_URI must match
# the app registration's redirect URI, e.g. https://<api-host>/api/v1/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=
# Per-user Microsoft 365 Calendar sync (delegated Graph Calendars.ReadWrite).
# Frontend callback the browser lands on after Entra consent; must be registered
# as a redirect URI on the same Entra app, e.g.
# https://psa.rivertowntechnology.com/settings/microsoft-calendar/callback
MS_CALENDAR_REDIRECT_URI=

# Customer portal "Sign in with Microsoft" (App B) — a SEPARATE, MULTI-TENANT
# Entra app so customers sign in with their OWN Microsoft 365 work/school
# accounts. Distinct credentials from the staff app above. Authority is
# /organizations (no tenant id). MS_PORTAL_REDIRECT_URI must be registered on
# App B, e.g. https://<api-host>/api/v1/portal/auth/microsoft/callback
# Register App B as multi-tenant with delegated openid/email/profile/User.Read
# (all user-consentable — NO admin-consent-required permissions).
MS_PORTAL_CLIENT_ID=
MS_PORTAL_CLIENT_SECRET=
MS_PORTAL_REDIRECT_URI=
# Customer portal SPA base URL (where the SSO exchange code is delivered).
PORTAL_URL=https://portal.rivertowntechnology.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_PATH=stripe

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=

# Twilio (optional fallback — prefer per-tenant config in Settings > Integrations)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Passkeys (WebAuthn)
PASSKEY_RP_ID=portal.rivertowntechnology.com
PASSKEY_ORIGIN=https://portal.rivertowntechnology.com

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_SANDBOX=false

# Apple Push Notification service (iOS push, token-based .p8 auth)
#
# Preferred: configure in-app under Settings > Integrations > Apple Push —
# credentials are stored encrypted in the database (same mechanism as
# Twilio/QuickBooks) and can be updated without a redeploy.
#
# These env vars are only a fallback, used if no Apple Push config exists in
# the database yet (e.g. for local dev bootstrap):
# Key ID of the .p8 signing key, from Apple Developer > Certificates, IDs & Profiles > Keys
APNS_KEY_ID=
# Your Apple Developer Team ID
APNS_TEAM_ID=
# iOS app's bundle identifier — sent as the apns-topic header
APNS_BUNDLE_ID=
# Contents of the .p8 key (PEM, with \n escaped) OR an absolute path to the .p8 file
APNS_KEY_P8=
