{
  "name": "@rivertown/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "pnpm --filter @rivertown/shared build && pnpm --filter @rivertown/db build && tsc",
    "start": "node --import tsx/esm src/app.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/websocket": "^11.0.0",
    "@rivertown/db": "workspace:*",
    "@rivertown/shared": "workspace:*",
    "@simplewebauthn/server": "^13.3.0",
    "basic-ftp": "^5.2.2",
    "bcryptjs": "^3.0.0",
    "bullmq": "^5.40.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.0",
    "fastify-plugin": "^5.0.0",
    "imapflow": "^1.2.18",
    "ioredis": "^5.6.0",
    "mailparser": "^3.9.6",
    "nodemailer": "^8.0.4",
    "otpauth": "^9.5.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.0",
    "puppeteer-core": "^24.40.0",
    "qrcode": "^1.5.4",
    "stripe": "^21.0.1",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
