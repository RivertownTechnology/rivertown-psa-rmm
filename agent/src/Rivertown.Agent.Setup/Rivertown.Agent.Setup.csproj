<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>RivertownAgentSetup</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <!-- Embedded agent binaries (populated by Build-Agent.ps1 before publishing Setup) -->
  <ItemGroup>
    <EmbeddedResource Include="embed\Rivertown.Agent.Core.exe" Condition="Exists('embed\Rivertown.Agent.Core.exe')" LogicalName="Rivertown.Agent.Core.exe" />
    <EmbeddedResource Include="embed\Rivertown.Agent.Tray.exe" Condition="Exists('embed\Rivertown.Agent.Tray.exe')" LogicalName="Rivertown.Agent.Tray.exe" />
    <EmbeddedResource Include="embed\RivertownUpdater.exe" Condition="Exists('embed\RivertownUpdater.exe')" LogicalName="RivertownUpdater.exe" />
  </ItemGroup>
</Project>
