# Database
DATABASE_URL=postgresql://rivertown:rivertown@localhost:5432/rivertown

# Redis
REDIS_URL=redis://localhost:6379

# MQTT
MQTT_URL=mqtt://localhost:1883

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (for integration credentials)
ENCRYPTION_KEY=change-me-32-byte-hex-string-here

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Stripe (configure when ready)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# QuickBooks Online (configure when ready)
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:3000/api/v1/integrations/quickbooks/callback

# Pax8 (configure when ready)
# PAX8_CLIENT_ID=
# PAX8_CLIENT_SECRET=
